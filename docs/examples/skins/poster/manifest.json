{
  "formatVersion": 2,
  "hostAPIVersion": 2,
  "version": "1.1.0",
  "descriptor": {
    "id": "example.poster",
    "name": "字里行间",
    "systemImage": "paintpalette",
    "surfaces": [
      "window",
      "fullscreen"
    ]
  },
  "requires": [
    "scene@2",
    "theme@1",
    "clock.playback@1",
    "host.pointer@1"
  ],
  "scene": {
    "root": {
      "type": "layer",
      "children": [
        {
          "type": "shape",
          "color": "=theme.ambientSurface",
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          }
        },
        {
          "type": "text",
          "text": "=track.title",
          "fontSize": 30,
          "weight": "bold",
          "design": "serif",
          "tracking": 1.5,
          "minScale": 0.7,
          "lineLimit": 1,
          "color": "=theme.appForeground.primary",
          "frame": {
            "x": "50%",
            "y": "9%",
            "width": "84%",
            "height": 48
          }
        },
        {
          "type": "scroll",
          "scrollTo": "=lyrics.currentIndex",
          "frame": {
            "x": "50%",
            "y": "48%",
            "width": "82%",
            "height": "66%"
          },
          "children": [
            {
              "type": "repeat",
              "items": "=lyrics.lines",
              "limit": 400,
              "spacing": 18,
              "template": {
                "type": "switch",
                "frame": {
                  "width": "82vw"
                },
                "on": {
                  "tap": {
                    "do": "seekToLyric",
                    "value": "=index"
                  }
                },
                "cases": [
                  {
                    "type": "lyricLine",
                    "when": "=index == lyrics.currentIndex",
                    "index": 0,
                    "fontSize": 27,
                    "weight": "semibold",
                    "lineSpacing": 4,
                    "color": "=theme.appForeground.secondary",
                    "highlightColor": "=theme.globalAccent",
                    "highlightStyle": "word",
                    "frame": {
                      "width": "82vw"
                    }
                  }
                ],
                "default": {
                  "type": "text",
                  "text": "=item.text",
                  "fontSize": 27,
                  "weight": "semibold",
                  "lineSpacing": 4,
                  "color": "=theme.appForeground.secondary",
                  "opacity": "=index < lyrics.currentIndex ? 0.4 : 1",
                  "frame": {
                    "width": "82vw"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "layer",
          "visible": "=!host.pointerIdle",
          "transition": "fade+fromBottom",
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          },
          "children": [
            {
              "type": "shape",
              "shape": "capsule",
              "color": "=theme.ambientSurface",
              "frame": {
                "x": "50%",
                "y": "90%",
                "width": 230,
                "height": 56
              },
              "opacity": 0.85
            },
            {
              "type": "symbol",
              "name": "backward.end.fill",
              "color": "=theme.appForeground.primary",
              "frame": {
                "x": "40%",
                "y": "90%",
                "width": 22,
                "height": 22
              },
              "on": {
                "tap": "previous"
              },
              "help": "上一首"
            },
            {
              "type": "symbol",
              "name": "=playback.isPlaying ? 'pause.fill' : 'play.fill'",
              "color": "=theme.appForeground.primary",
              "frame": {
                "x": "50%",
                "y": "90%",
                "width": 22,
                "height": 22
              },
              "on": {
                "tap": "playPause"
              },
              "help": "播放或暂停"
            },
            {
              "type": "symbol",
              "name": "forward.end.fill",
              "color": "=theme.appForeground.primary",
              "frame": {
                "x": "60%",
                "y": "90%",
                "width": 22,
                "height": 22
              },
              "on": {
                "tap": "next"
              },
              "help": "下一首"
            },
            {
              "type": "shape",
              "shape": "capsule",
              "color": "=theme.appForeground.quaternary",
              "frame": {
                "x": "50%",
                "y": "96%",
                "width": "72%",
                "height": 5
              },
              "on": {
                "drag": {
                  "do": "seek",
                  "value": "=gesture.fractionX * playback.duration"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
