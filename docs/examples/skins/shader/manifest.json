{
  "formatVersion": 2,
  "hostAPIVersion": 2,
  "version": "1.0.0",
  "descriptor": {
    "id": "example.shader",
    "name": "流彩",
    "systemImage": "paintpalette",
    "surfaces": [
      "window",
      "fullscreen"
    ]
  },
  "requires": [
    "scene@2",
    "theme@1",
    "clock.playback@1"
  ],
  "scene": {
    "root": {
      "type": "layer",
      "children": [
        {
          "type": "shader",
          "path": "shaders/flow.metal",
          "function": "skinColor",
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          }
        },
        {
          "type": "particles",
          "color": "=theme.globalAccent",
          "count": 72,
          "speed": 0.03,
          "size": 1.2,
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          },
          "opacity": 0.35
        },
        {
          "type": "component",
          "component": "lyrics.native",
          "props": {
            "fontSize": 40,
            "textColor": "#FFFFFF"
          },
          "frame": {
            "x": "50%",
            "y": "43%",
            "width": "84%",
            "height": "68%"
          }
        },
        {
          "type": "component",
          "component": "control.transport",
          "props": {
            "color": "#FFFFFF"
          },
          "frame": {
            "x": "50%",
            "y": "90%",
            "width": 220,
            "height": 48
          },
          "glass": {
            "style": "clear",
            "shape": "capsule"
          }
        }
      ]
    }
  }
}
