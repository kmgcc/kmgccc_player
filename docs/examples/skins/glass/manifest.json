{
  "formatVersion": 2,
  "hostAPIVersion": 2,
  "version": "1.3.0",
  "descriptor": {
    "id": "example.glass",
    "name": "浮光",
    "systemImage": "paintpalette",
    "surfaces": [
      "window",
      "fullscreen"
    ]
  },
  "requires": [
    "scene@2",
    "theme@1",
    "host@1",
    "clock.playback@1"
  ],
  "scene": {
    "root": {
      "type": "layer",
      "children": [
        {
          "type": "switch",
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          },
          "cases": [
            {
              "type": "component",
              "component": "background.art",
              "when": "=params.backdrop == 'art'",
              "frame": {
                "width": "100%",
                "height": "100%"
              }
            }
          ],
          "default": {
            "type": "artwork",
            "fit": "fill",
            "blur": 18,
            "frame": {
              "width": "100%",
              "height": "100%"
            }
          }
        },
        {
          "type": "component",
          "component": "background.dimming",
          "props": {
            "intensity": "=params.dimming"
          },
          "frame": {
            "x": "50%",
            "y": "50%",
            "width": "100%",
            "height": "100%"
          }
        },
        {
          "type": "component",
          "component": "lyrics.native",
          "visible": "=host.lyricsVisible",
          "props": {
            "userSettings": ["font", "spring"],
            "highlight": "=params.highlight",
            "hierarchy": "=params.hierarchy",
            "activeColor": "#FFFFFF",
            "inactiveLevel": 0.4,
            "alignPosition": 0.45
          },
          "frame": {
            "x": "50%",
            "y": "43%",
            "width": "84%",
            "height": "68%"
          }
        },
        {
          "type": "component",
          "component": "control.miniPlayer",
          "adaptive": true,
          "props": {
            "width": "=params.barWidth",
            "showsProgress": "=params.showsProgress",
            "showsPlaybackMode": false,
            "showsVolume": "=params.showsVolume"
          },
          "frame": {
            "x": "50%",
            "y": "=host.layout.miniPlayer.midY",
            "width": "100%",
            "height": "=host.layout.miniPlayer.height"
          }
        }
      ]
    }
  },
  "parameters": [
    {
      "id": "backdrop",
      "section": "背景",
      "title": "背景",
      "defaultValue": "art",
      "control": {
        "type": "choice",
        "choices": [
          {
            "id": "art",
            "title": "艺术背景"
          },
          {
            "id": "blur",
            "title": "封面模糊"
          }
        ]
      },
      "isUserVisible": true
    },
    {
      "id": "dimming",
      "section": "背景",
      "title": "背景压暗",
      "defaultValue": 0.3,
      "control": {
        "type": "range",
        "min": 0,
        "max": 0.7,
        "step": 0.05
      },
      "isUserVisible": true
    },
    {
      "id": "highlight",
      "section": "歌词",
      "title": "高亮方式",
      "defaultValue": "smooth",
      "control": {
        "type": "choice",
        "choices": [
          {
            "id": "smooth",
            "title": "扫光"
          },
          {
            "id": "discrete",
            "title": "逐字"
          }
        ]
      },
      "isUserVisible": true
    },
    {
      "id": "hierarchy",
      "section": "歌词",
      "title": "歌词层次",
      "defaultValue": "opacity",
      "control": {
        "type": "choice",
        "choices": [
          {
            "id": "opacity",
            "title": "透明度"
          },
          {
            "id": "brightness",
            "title": "明度"
          }
        ]
      },
      "isUserVisible": true
    },
    {
      "id": "barWidth",
      "section": "播放条",
      "title": "播放条长度",
      "defaultValue": 900,
      "control": {
        "type": "range",
        "min": 620,
        "max": 1150,
        "step": 10
      },
      "isUserVisible": true
    },
    {
      "id": "showsProgress",
      "section": "播放条",
      "title": "显示进度",
      "defaultValue": true,
      "control": {
        "type": "toggle"
      },
      "isUserVisible": true
    },
    {
      "id": "showsVolume",
      "section": "播放条",
      "title": "显示音量",
      "defaultValue": true,
      "control": {
        "type": "toggle"
      },
      "isUserVisible": true
    }
  ]
}
