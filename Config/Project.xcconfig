// Project-wide build configuration shared across all targets and configurations.

BUILD_EXTENSION_MODE = auto
BUILD_EXTENSION_HOOK =
BUILD_EXTENSION_STRICT = NO

// Production is the compatibility default. Local test builds must override the
// complete group below; UpdateEnvironment rejects missing or malformed values.
UPDATE_RELEASE_CHANNEL = production
UPDATE_PRIMARY_FEED_URL = https:/$()/player.kmgccc.cn/api/v1/updates/appcast.xml
UPDATE_FALLBACK_FEED_URL = https:/$()/kmgcc.github.io/kmgccc_player/appcast.xml
PRODUCTION_UPDATE_PUBLIC_ED_KEY = +cu8qqhgtPnFd0DUYj5PLW0kuhT1qGpi6JUOxEgdqNg=
UPDATE_PUBLIC_ED_KEY = $(PRODUCTION_UPDATE_PUBLIC_ED_KEY)
TEST_UPDATE_PRIMARY_FEED_URL =
TEST_UPDATE_FALLBACK_FEED_URL =
TEST_UPDATE_PUBLIC_ED_KEY =
APP_BUNDLE_IDENTIFIER = kmgccc.player
APP_DISPLAY_NAME = kmgccc_player

// Machine-specific values, when present, override the safe defaults above.
#include? "LocalOverrides.xcconfig"
