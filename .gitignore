# docs/ contains private working notes, AI-generated docs, and local web assets.
# Tracked by its own Git repo inside docs/ for local version control.
docs/
# The public release notes live in the tracked, case-sensitive app Docs path.
!kmgccc_player/Docs/
kmgccc_player/Docs/*
!kmgccc_player/Docs/ReleaseBoundary.md

# Manual exclusions
# Private distribution art inputs and encrypted runtime assets must never enter
# the public source history. The public build supplies procedural fallbacks.
/BKThemes/
/PrivateArtSources/
# Migrated art masters stay private; runtime audio remains tracked under
# kmgccc_player/Resources/Audio/.
/EncryptedArtAssets/
/BKArt.bundle/
/kmgccc_player/Resources/BKArt.bundle/
# Private Bokeh source is compiled only by the private distribution workspace.
/kmgccc_player/Rendering/BokehTransition/BokehTransitionShader.metal
/kmgccc_player/Rendering/BokehTransition/*.metallib
# Encryption tools and allowlists live in the private resources repository.
scripts/encrypt_art_assets.swift
scripts/encrypted_asset_allowlist.json
apple-audio-visualization-main/
# AMLL source worktrees live in ../amll-sources/.
applemusic-like-lyrics-full-refractor/
applemusic-like-lyrics-full-custom-core/
LDDC-main/
skills/
ARCHITECTURE.md
AGENTS.md
CLAUDE.md
GEMINI.md
kmgccc_player_demo.pptx
scan_ui.py
ui_candidates.txt
kmgccc_player/scan_ui.py
kmgccc_player/ui_candidates.txt
